{
  "name": "brunosrz-portfolio",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "node scripts/warm-paraglide-wasm.mjs && vite build",
    "deploy": "scons deploy",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "node scripts/warm-paraglide-wasm.mjs && bun run i18n:compile && bun run generate-routes && tsc --noEmit",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/warm-paraglide-wasm.mjs && bun run i18n:compile && bun run generate-routes && vitest run --passWithNoTests --pool=forks --maxWorkers=1 --no-isolate",
    "test:watch": "vitest",
    "test:coverage": "node scripts/warm-paraglide-wasm.mjs && bun run i18n:compile && bun run generate-routes && vitest run --coverage --passWithNoTests --pool=forks --maxWorkers=1 --no-isolate",
    "test:e2e": "node scripts/warm-paraglide-wasm.mjs && playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@lix-js/sdk": "0.20.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "nitro": "3.0.261029-rc",
    "oxlint": "^1.90.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "lightningcss"
  ]
}
